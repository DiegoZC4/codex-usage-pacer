{
  "manifest_version": 3,
  "name": "Codex Usage Pacer",
  "version": "0.8.0",
  "description": "Adds pacing markers, usage history, reset logging, and focus refreshes to the Codex usage dashboard.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/codex/cloud/settings/analytics*"
      ],
      "js": [
        "reset-log-core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
